# Copy this file to .env and fill in real values. .env is gitignored and must never be committed.
#
# IMPORTANT: Expo bundles every EXPO_PUBLIC_* variable into the app, so anyone can read them.
# Only put values here that are safe to be public (e.g. AdMob ad unit IDs). Real secrets
# (server API keys, tokens, signing keys) must live on a server or in EAS Secrets:
#   npx eas-cli@latest secret:create

# Rewarded ad unit used to skip the unblock wait (see src/lib/ads.ts)
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_IOS=
